# ─── MongoDB ──────────────────────────────────────────────────────────────────
# Lokal: mongodb://localhost:27017
# Atlas:  mongodb+srv://<user>:<password>@cluster.mongodb.net
MONGO_URL=mongodb://localhost:27017
DB_NAME=dermvision

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Güçlü, rastgele bir secret key kullanın (en az 32 karakter)
JWT_SECRET=change-me-to-a-strong-random-secret

# ─── CORS ─────────────────────────────────────────────────────────────────────
# İzin verilecek origin'ler (virgülle ayırın)
CORS_ORIGINS=http://localhost:3000,http://localhost:8081

# ─── Backend URL ──────────────────────────────────────────────────────────────
BACKEND_URL=http://localhost:8000

# ─── İyzico Ödeme ─────────────────────────────────────────────────────────────
# https://dev.iyzipay.com adresinden alabilirsiniz
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
# Sandbox: https://sandbox-api.iyzipay.com
# Canlı:   https://api.iyzipay.com
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com
